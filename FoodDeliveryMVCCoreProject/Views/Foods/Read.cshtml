@model IEnumerable<FoodDetails>


<table border="1">

    <tr>
        <th>FoodId</th>
        <th>FoodName</th>
        <th>Category</th>
        <th>Price</th>
        <th>IsAvailable</th>
        <th>Edit</th>
        <th>Delete</th>
    </tr>
 
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.FoodId</td>
            <td>@item.FoodName</td>
            <td>@item.Category</td>
            <td>@item.Price</td>
            <td>@item.IsAvailable</td>
            <td><a asp-controller="Foods" asp-action="Edit" asp-route-FoodId="@item.FoodId">Edit</a></td>
            <td><a asp-controller="Foods" asp-action="Delete" asp-route-FoodId="@item.FoodId">Delete</a></td>

        </tr>        
    }
    </table>
@if (TempData["Msg"] != null)
{
    <h3>@TempData["Msg"]</h3>
}
<h3><a asp-controller="Foods" asp-action="Create">Go Back</a></h3>